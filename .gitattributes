# Normalise line endings so the repository looks the same on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf

# Binary files: never touched by line-ending conversion or text diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.aab binary
*.apk binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary
