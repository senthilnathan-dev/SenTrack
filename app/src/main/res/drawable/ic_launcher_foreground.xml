    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33,76 L33,64 Q33,62 35,62 L41,62 Q43,62 43,64 L43,76 Z" />
    <!-- Middle bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49,76 L49,52 Q49,50 51,50 L57,50 Q59,50 59,52 L59,76 Z" />
    <!-- Tall bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M65,76 L65,40 Q65,38 67,38 L73,38 Q75,38 75,40 L75,76 Z" />
    <!-- Spark -->
    <path
        android:fillColor="#FFB84D"
        android:pathData="M70,22 L72.2,27.8 L78,30 L72.2,32.2 L70,38 L67.8,32.2 L62,30 L67.8,27.8 Z" />
